# Server-side SDK key for the LaunchDarkly environment holding both AI Configs.
LAUNCHDARKLY_SDK_KEY=sdk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# OpenAI key. The model name comes from each AI Config variation, not from here.
OPENAI_API_KEY=sk-your-openai-key

# Optional overrides. Defaults match the keys in the README; keep them in sync with LD.
# LD_RAPPER_CONFIG_KEY=archetype-rapper-config
# LD_JUDGE_CONFIG_KEY=battle-judge-config
# OPENAI_TIMEOUT_MS=20000
# LD_INIT_TIMEOUT_SECONDS=10
